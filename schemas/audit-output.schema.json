{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "next_steps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["clean", "needs-attention", "needs-work", "blocked"],
      "description": "Overall audit verdict"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Executive summary of audit findings"
    },
    "audit_type": {
      "type": "string",
      "enum": ["mini", "full"],
      "description": "Whether this was a 5-dimension mini or 9-dimension full audit"
    },
    "scope": {
      "type": "string",
      "description": "What was audited (files, directories, commit range)"
    },
    "model": {
      "type": "string",
      "description": "Codex model used for the audit"
    },
    "thread_id": {
      "type": "string",
      "description": "Thread ID for /continue follow-up"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "body", "file", "dimension"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "dimension": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "description": "Which audit dimension this finding belongs to"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "dimension_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "name", "critical", "high", "medium", "low"],
        "properties": {
          "dimension": { "type": "integer", "minimum": 1, "maximum": 9 },
          "name": { "type": "string" },
          "critical": { "type": "integer", "minimum": 0 },
          "high": { "type": "integer", "minimum": 0 },
          "medium": { "type": "integer", "minimum": 0 },
          "low": { "type": "integer", "minimum": 0 }
        }
      },
      "description": "Issue counts broken down by dimension"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
